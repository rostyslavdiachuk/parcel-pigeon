# Copy to .env (scripts/dev.sh does this for you) and adjust as needed.

COMPOSE_PROJECT_NAME=parcelpigeon

# --- PostgreSQL ---
POSTGRES_USER=parcelpigeon
POSTGRES_PASSWORD=parcelpigeon
POSTGRES_DB=shipments

# --- Gateway ---
# Stub auth: when set, non-GET /api/* requests must send `x-api-key: <this>`.
# Leave empty to disable the check entirely.
GATEWAY_API_KEY=
